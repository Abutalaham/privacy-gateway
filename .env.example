PG_LLM_PROVIDER=anthropic          # anthropic | openai | ollama | local | mock
PG_FALLBACK=local                  # local | ollama | none
PG_AUDIT_BACKEND=sqlite            # sqlite | supabase
PG_SUPABASE_URL=                   # required when PG_AUDIT_BACKEND=supabase
PG_SUPABASE_SERVICE_ROLE_KEY=      # server-only; never expose to the frontend
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PG_USE_GLINER=0                    # 1 = enable GLiNER (pip install gliner)
PG_MAX_UPLOAD_BYTES=10485760       # 10 MiB
PG_MAX_DOCUMENT_CHARS=1000000
PG_MAX_DOCUMENT_PAGES=500
PG_DOCUMENT_TTL_SECONDS=900
PG_MAX_ACTIVE_DOCUMENTS=100
PG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
